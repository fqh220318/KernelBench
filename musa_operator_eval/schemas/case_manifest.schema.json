{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelbench.local/musa/schemas/case-manifest-1.0.0.json",
  "title": "MUSA evaluation case manifest (tasks/*/public_cases.json and the private manifest)",
  "description": "Guide §4.3. One format for both the public and the hidden list; only the content and the visibility differ. The tier decides which dispatch fields a case may carry: an A_kernel case that names an expected path or a library gap is a leak (those are B-tier concepts), and a B_library case without an expected path is not gradable. A public B manifest must not carry a gap, because that would hand the submission the configuration the task exists to make it discover.",
  "$defs": {
    "path": {
      "enum": [
        "fused_library",
        "library_composition",
        "custom_fallback"
      ]
    },
    "gap_reason": {
      "enum": [
        "unsupported_shape",
        "semantic_mismatch",
        "layout_mismatch",
        "multi_operator_required"
      ]
    },
    "shape": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "tag",
        "seed",
        "dtype",
        "shape"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "tag": {
          "enum": [
            "smoke",
            "correctness",
            "boundary",
            "non_aligned",
            "extreme",
            "perf"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "dtype": {
          "enum": [
            "float16",
            "bfloat16",
            "float32"
          ]
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "attributes": {
          "type": "object"
        },
        "distribution": {
          "enum": [
            "normal",
            "uniform",
            "adversarial_extremes"
          ]
        },
        "golden": {
          "type": "string",
          "minLength": 1
        },
        "expected_path": {
          "$ref": "#/$defs/path"
        },
        "library_gap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "expected_path",
            "evidence"
          ],
          "properties": {
            "reason": {
              "$ref": "#/$defs/gap_reason"
            },
            "expected_path": {
              "enum": [
                "library_composition",
                "custom_fallback"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "tier",
    "visibility",
    "case_generation",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "tier": {
      "enum": [
        "A_kernel",
        "B_library"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "set_entry": {
      "type": "string",
      "minLength": 2
    },
    "case_generation": {
      "type": "object",
      "required": [
        "tool",
        "deterministic"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 3
        },
        "deterministic": {
          "const": true
        },
        "outputs": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "generalization_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "seed_source",
        "count",
        "dtype_choices",
        "shape_space",
        "template"
      ],
      "properties": {
        "generator": {
          "const": "musa_operator_eval/evaluator/generalization_probe.py"
        },
        "seed_source": {
          "const": "runtime_entropy"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "dtype_choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["float16", "bfloat16", "float32"]
          }
        },
        "shape_space": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["choices"],
                "properties": {
                  "choices": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "integer", "minimum": 1}
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["minimum", "maximum"],
                "properties": {
                  "minimum": {"type": "integer", "minimum": 1},
                  "maximum": {"type": "integer", "minimum": 1},
                  "step": {"type": "integer", "minimum": 1}
                }
              }
            ]
          }
        },
        "template": {
          "type": "object"
        },
        "expected_path_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "when": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "equals": {"type": "integer", "minimum": 1},
                    "choices": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {"type": "integer", "minimum": 1}
                    },
                    "minimum": {"type": "integer", "minimum": 1},
                    "maximum": {"type": "integer", "minimum": 1}
                  }
                }
              },
              "path": {"$ref": "#/$defs/path"}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["visibility"],
        "properties": {"visibility": {"const": "public"}}
      },
      "then": {
        "not": {"required": ["generalization_probe"]}
      },
      "else": {
        "required": ["generalization_probe"]
      }
    },
    {
      "if": {
        "required": ["tier", "visibility"],
        "properties": {
          "tier": {"const": "B_library"},
          "visibility": {"const": "private"}
        }
      },
      "then": {
        "properties": {
          "generalization_probe": {
            "required": ["expected_path_rules"]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "tier"
        ],
        "properties": {
          "tier": {
            "const": "A_kernel"
          }
        }
      },
      "then": {
        "properties": {
          "cases": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "expected_path"
                    ]
                  },
                  {
                    "required": [
                      "library_gap"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "tier"
        ],
        "properties": {
          "tier": {
            "const": "B_library"
          }
        }
      },
      "then": {
        "properties": {
          "cases": {
            "items": {
              "required": [
                "expected_path"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "tier",
          "visibility"
        ],
        "properties": {
          "tier": {
            "const": "B_library"
          },
          "visibility": {
            "const": "public"
          }
        }
      },
      "then": {
        "description": "A public B case is graded on the fused path; announcing a gap there tells the submission where the boundary is.",
        "properties": {
          "cases": {
            "items": {
              "allOf": [
                {
                  "not": {
                    "required": [
                      "library_gap"
                    ]
                  }
                },
                {
                  "properties": {
                    "expected_path": {
                      "const": "fused_library"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
