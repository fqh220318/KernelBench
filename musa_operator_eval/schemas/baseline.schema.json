{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelbench.local/musa/schemas/baseline-1.0.0.json",
  "title": "MUSA task baseline (private/*/baseline.json)",
  "description": "Guide §4.4. A baseline is only meaningful against the environment it was measured in, so the snapshot id is required and every row has to say which implementation it belongs to. A requires upstream_musa, mudnn_fused, torch_musa_sdpa and torch_musa_eager; B adds naive_library_composition (the lower bound) and expert_dispatch (the speedup denominator). The readiness summary is re-derived by the validator, gate and ranker, and an unavailable mandatory row is incomplete rather than scoreable.",
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "implementation",
        "status"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "error",
            "unavailable",
            "unsupported"
          ],
          "description": "pass: the implementation answered and agreed with the reference. fail: it answered and disagreed. error: the call raised, which is what a library does when it declines a configuration -- a different fact from a wrong answer and from an implementation that could not be built at all (unavailable). A row with no status is a missing measurement, which is why the enum is closed."
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "throughput": {
          "type": [
            "number",
            "null"
          ]
        },
        "peak_memory_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "numeric": {
          "type": "object"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "dispatch_trace_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "recorded_paths": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The paths the implementation's own trace reported. Recorded so a mismatch can be read without re-running; null when nothing was recorded."
        },
        "latency_ms_p10": {
          "type": [
            "number",
            "null"
          ],
          "description": "Guide §4.4's quantiles: the nearest-rank 10th percentile of the measured trials."
        },
        "latency_ms_p90": {
          "type": [
            "number",
            "null"
          ]
        },
        "throughput_per_second": {
          "type": [
            "number",
            "null"
          ],
          "description": "Invocations of the case's operation per second, derived from `latency_ms`, which is the framework's mean of the trials."
        },
        "latency_ms_samples": {
          "description": "The samples the statistic and the quantiles were derived from: the trials the framework's timing loop ran, minus its discarded first one. Named for samples rather than rounds because the framework's loop has one pass, and calling a trial a round would describe a structure it does not have.",
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "latency_ms_stats": {
          "description": "The framework's own summary of the same trials (`kernelbench.timing.get_timing_stats`), kept so a reader can see the spread the mean came from.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "mean",
            "std",
            "min",
            "max",
            "num_trials"
          ],
          "properties": {
            "mean": {
              "type": [
                "number",
                "null"
              ]
            },
            "std": {
              "type": [
                "number",
                "null"
              ]
            },
            "min": {
              "type": [
                "number",
                "null"
              ]
            },
            "max": {
              "type": [
                "number",
                "null"
              ]
            },
            "num_trials": {
              "type": "integer"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "unavailable"}}
          },
          "then": {"required": ["reason"]}
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "tier",
    "environment_snapshot",
    "measurement_protocol",
    "implementations",
    "results",
    "scoring",
    "readiness"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "tier": {
      "enum": [
        "A_kernel",
        "B_library"
      ]
    },
    "environment_snapshot": {
      "type": "string",
      "minLength": 3
    },
    "measurement_protocol": {
      "type": "object",
      "required": [
        "warmup",
        "measurements",
        "rounds",
        "statistic"
      ],
      "properties": {
        "warmup": {
          "type": "integer",
          "minimum": 1
        },
        "measurements": {
          "type": "integer",
          "minimum": 1
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "statistic": {
          "type": "string",
          "minLength": 1
        },
        "timer": {
          "type": "string",
          "minLength": 1
        },
        "clock_locked": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Guide §4.4 asks the protocol to say whether the clock was pinned. Null means the platform does not expose it, which is a fact about the machine rather than a missing field."
        },
        "cache": {
          "description": "The cache state the protocol measures in. The framework thrashes L2 before every trial, so its numbers are cold-cache numbers and a warm-cache number cannot be compared with them.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "The function that defines the protocol, so a reader can check it rather than trust the block.",
          "type": [
            "string",
            "null"
          ]
        },
        "discard_first": {
          "type": [
            "integer",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "weight_alignment": {
      "type": "string"
    },
    "tolerance_source": {
      "type": "string"
    },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "required_roles", "case_count", "missing_roles", "missing_rows",
        "duplicate_rows", "unavailable_rows", "nonpassing_rows", "problems"
      ],
      "properties": {
        "status": {"enum": ["complete", "incomplete"]},
        "required_roles": {
          "type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}
        },
        "case_count": {"type": "integer", "minimum": 0},
        "missing_roles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "missing_rows": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "duplicate_rows": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unavailable_rows": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "nonpassing_rows": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "problems": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scoring": {
      "type": "object",
      "required": [
        "speedup_denominator",
        "correctness_gate"
      ],
      "properties": {
        "speedup_denominator": {
          "type": "string",
          "minLength": 1
        },
        "reference_implementation": {
          "type": "string"
        },
        "correctness_gate": {
          "const": "all_hidden_cases"
        },
        "minimum_naive_to_expert_ratio": {
          "type": "number",
          "minimum": 1.3
        }
      }
    },
    "declared_tolerance": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "The task's own `tolerances.max_abs_error`, which the resolver takes as a loosen-only override."
    },
    "resolved_tolerances": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      },
      "description": "What the tolerance resolved to per dtype for this run, so a `max_abs_diff exceeds` row can be read without looking up the framework's table."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "tier"
        ],
        "properties": {
          "tier": {
            "const": "B_library"
          }
        }
      },
      "then": {
        "properties": {
          "implementations": {
            "allOf": [
              {
                "not": {
                  "items": {
                    "not": {
                      "const": "naive_library_composition"
                    }
                  }
                }
              },
              {
                "not": {
                  "items": {
                    "not": {
                      "const": "expert_dispatch"
                    }
                  }
                }
              },
              {
                "not": {
                  "items": {
                    "not": {
                      "const": "upstream_musa"
                    }
                  }
                }
              },
              {
                "not": {
                  "items": {
                    "not": {
                      "const": "mudnn_fused"
                    }
                  }
                }
              },
              {
                "not": {
                  "items": {
                    "not": {
                      "const": "torch_musa_sdpa"
                    }
                  }
                }
              },
              {
                "not": {
                  "items": {
                    "not": {
                      "const": "torch_musa_eager"
                    }
                  }
                }
              }
            ]
          },
          "scoring": {
            "properties": {
              "speedup_denominator": {
                "const": "expert_dispatch"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["tier"],
        "properties": {"tier": {"const": "A_kernel"}}
      },
      "then": {
        "properties": {
          "implementations": {
            "allOf": [
              {"not": {"items": {"not": {"const": "upstream_musa"}}}},
              {"not": {"items": {"not": {"const": "mudnn_fused"}}}},
              {"not": {"items": {"not": {"const": "torch_musa_sdpa"}}}},
              {"not": {"items": {"not": {"const": "torch_musa_eager"}}}}
            ]
          },
          "scoring": {
            "properties": {"speedup_denominator": {"const": "upstream_musa"}}
          }
        }
      }
    }
  ]
}
