{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelbench.local/musa/schemas/task-contract-1.0.0.json",
  "title": "MUSA operator task contract (tasks/*/task.json)",
  "description": "Guide §4.8: `tier` is an enum and the validator tightens or loosens the fields by its value. An A_kernel contract that carries a library policy is an error (that is a B-tier concept leaking into the tier that forbids libraries), and a B_library contract that does not define its library gap requirement is an error. The machine-readable form of the hand-written assertions in tests/test_task_packages.py.",
  "$defs": {
    "gap_reason": {
      "enum": [
        "unsupported_shape",
        "semantic_mismatch",
        "layout_mismatch",
        "multi_operator_required"
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "command_block": {
      "description": "A command the inventory publishes, with the reason it is the command and not another.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "note"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 3
        },
        "note": {
          "type": "string",
          "minLength": 10
        },
        "script": {
          "type": "string",
          "description": "A package-relative script the command runs, when the command is a script rather than a tool invocation.",
          "minLength": 3
        }
      }
    },
    "tolerance_triplet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atol", "rtol", "max_abs_error"],
      "properties": {
        "atol": {"type": "number", "minimum": 0},
        "rtol": {"type": "number", "minimum": 0},
        "max_abs_error": {"type": "number", "minimum": 0}
      }
    },
    "tolerance_profile": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "float16": {"$ref": "#/$defs/tolerance_triplet"},
        "bfloat16": {"$ref": "#/$defs/tolerance_triplet"},
        "float32": {"$ref": "#/$defs/tolerance_triplet"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tier",
    "id",
    "name",
    "family",
    "target_environment",
    "problem_file",
    "reference",
    "case_parameters",
    "tolerance_profiles",
    "performance_protocol",
    "tensor_contract",
    "prohibited",
    "submission",
    "attempt_budget",
    "outputs",
    "scoring",
    "starter"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tier": {
      "enum": [
        "A_kernel",
        "B_library"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "family": {
      "type": "string",
      "minLength": 2
    },
    "normative_spec": {
      "const": "1.0.0",
      "description": "Present only after migration to the Phase 21 executable specification."
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_status",
        "reference_origin"
      ],
      "properties": {
        "release_status": {
          "enum": [
            "migration_required",
            "hardware_pending",
            "release_ready"
          ]
        },
        "reference_origin": {
          "enum": [
            "legacy_upstream_copy",
            "independent_cpu_reference"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason"
      ],
      "properties": {
        "decision": {
          "enum": [
            "keep",
            "redesign_new_id",
            "retire",
            "research_only"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 20
        },
        "successor_policy": {
          "enum": [
            "not_applicable",
            "new_task_id_required"
          ]
        }
      }
    },
    "scope": {
      "enum": [
        "entry",
        "family"
      ]
    },
    "set_entry": {
      "type": "string",
      "minLength": 2
    },
    "covers": {
      "description": "Family-scoped packages name the entries they cover instead of claiming one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "record",
        "revision",
        "license",
        "snapshot_location",
        "snapshot_revision"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 3
        },
        "record": {
          "type": "string",
          "minLength": 3
        },
        "revision": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "snapshot_location": {
          "type": "string"
        },
        "snapshot_revision": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{16}$",
      "description": "Opaque public identifier. It cannot contain a repository, path, revision or licence."
    },
    "target_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "record",
        "backend"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 3
        },
        "record": {
          "type": "string",
          "pattern": "^environments/.+\\.public\\.json$"
        },
        "backend": {
          "enum": [
            "musa"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "problem_file": {
      "type": "string",
      "pattern": "\\.py$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.py:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "golden_oracle": {
      "description": "Guide §5 step 3. When a package ships a reference separate from problem.py, this names it, and generate_cases.py computes the golden from it instead of from the model. `returns` names the golden tensors in the order the oracle returns them.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "entrypoint",
        "returns",
        "state_handling"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 3
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "returns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          }
        },
        "state_handling": {
          "description": "How the independent oracle obtains model parameters and buffers. Stateful normative tasks either receive the framework-materialized state directly or replay the public constructor from deterministic context; stateless tasks declare that no model state exists.",
          "enum": [
            "stateless",
            "explicit_model_state",
            "deterministic_constructor_replay"
          ]
        },
        "context": {
          "description": "Optional deterministic construction context passed to the oracle as keyword arguments. This is for references whose output depends on seeded model state without making that state part of the submission input ABI.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "case_seed",
              "init_inputs",
              "model_state"
            ]
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "capability_reference": {
      "type": "string",
      "pattern": "^agent_reference/.+_capabilities\\.json$"
    },
    "case_parameters": {
      "description": "Dotted path inside a case entry -> module-level name in problem.py.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/identifier"
      }
    },
    "tolerance_profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/tolerance_profile"},
      "description": "Named per-dtype profiles. atol and rtol are independently floored by the framework; max_abs_error is an independent hard ceiling."
    },
    "performance_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timer", "warmup", "measurements", "discard_first", "cache",
        "statistic", "diagnostics"
      ],
      "properties": {
        "timer": {"const": "device_event"},
        "warmup": {"const": 3},
        "measurements": {"const": 100},
        "discard_first": {"const": 1},
        "cache": {"const": "l2_flush_each_trial"},
        "statistic": {"const": "mean"},
        "diagnostics": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 7,
          "items": {
            "enum": ["samples", "p10", "p50", "p90", "std", "min", "max"]
          }
        }
      },
      "description": "The single formal timing protocol shared by submissions and denominators."
    },
    "tensor_contract": {
      "description": "Guide §4.1. The precision a task is graded at is part of the contract, not a CLI default.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_dtypes",
        "accumulation_dtype"
      ],
      "properties": {
        "input_dtypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "float16",
              "bfloat16",
              "float32"
            ]
          }
        },
        "accumulation_dtype": {
          "enum": [
            "float32",
            "float64"
          ]
        },
        "layouts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "dynamic_axes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "hyperparameters": {
      "type": "object"
    },
    "prohibited": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "fallback_kernel": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "attempt_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "wall_time_seconds"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "wall_time_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "kernel_scope": {
      "description": "A-tier only: what must stay in the kernel versus what may remain a library call.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "enforced_by",
        "must_be_in_kernel",
        "may_stay_library"
      ],
      "properties": {
        "level": {
          "enum": [
            "attention_core",
            "whole_problem"
          ]
        },
        "enforced_by": {
          "type": "string",
          "minLength": 1
        },
        "enforced_note": {
          "type": "string"
        },
        "must_be_in_kernel": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "may_stay_library": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speedup",
        "ranking",
        "denominator_policy"
      ],
      "properties": {
        "speedup": {
          "type": "string",
          "minLength": 3
        },
        "ranking": {
          "type": "string",
          "minLength": 3
        },
        "gate": {
          "type": "string"
        },
        "denominator_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary", "fallback", "fallback_condition", "selection_scope", "selection_record"
          ],
          "properties": {
            "primary": {"type": "string", "minLength": 3},
            "fallback": {"type": "string", "minLength": 3},
            "fallback_condition": {"type": "string", "minLength": 10},
            "selection_scope": {"const": "per_scoring_case"},
            "selection_record": {"const": "private_baseline.denominator_by_case"}
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "measured",
            "pending_device_measurement",
            "blocked_gap_coverage"
          ]
        },
        "decision": {
          "enum": [
            "admit",
            "reject"
          ]
        },
        "reason": {
          "type": "string"
        },
        "gate": {
          "type": "string"
        },
        "threshold": {
          "type": "number"
        },
        "evidence": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "dispatch_note": {
          "type": "string"
        },
        "gap_reason_coverage": {
          "description": "Guide §4.3 requires at least two gap-reason categories. A package that cannot reach two records the blocker here; the record explains why it is not scoreable and does not waive the floor.",
          "type": "object",
          "required": [
            "state",
            "reachable",
            "unreachable",
            "basis"
          ],
          "properties": {
            "state": {
              "enum": [
                "blocked",
                "covered"
              ]
            },
            "reachable": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/gap_reason"
              }
            },
            "unreachable": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/gap_reason"
              }
            },
            "basis": {
              "type": "string",
              "minLength": 10
            }
          }
        },
        "route_probe": {
          "type": "object"
        },
        "public_case_baseline": {
          "type": "object"
        },
        "measured_geometric_mean": {
          "type": "number"
        },
        "measured_in": {
          "type": "string"
        },
        "how_to_read_the_mean": {
          "type": "string"
        },
        "also_answered": {
          "type": "string"
        }
      },
      "description": "Guide §4.4. The contract records the gate's outcome, and only its outcome: whether the task was admitted, at what threshold and in which environment. The per-case evidence -- each hidden case's naive/expert ratio, and where that record lives -- stays in `private/<task id>/`, because §2 does not hand the agent the hidden set and a ratio table keyed by hidden case ids is a description of it.",
      "additionalProperties": false
    },
    "library_policy": {
      "description": "B-tier only. Guide §4.1: allowed libraries and symbol prefixes, the dispatch file, the required dispatch trace, and the library gap requirement.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_libraries",
        "allowed_symbol_prefixes",
        "required_trace_fields",
        "trace_env_var",
        "case_id_env_var",
        "minimum_gap_cases",
        "required_gap_reasons"
      ],
      "properties": {
        "allowed_libraries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_symbol_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dispatch_order": {
          "type": "array",
          "items": {
            "enum": [
              "fused_library",
              "library_composition",
              "custom_fallback"
            ]
          }
        },
        "dispatch_file": {
          "type": "string",
          "minLength": 3
        },
        "required_trace_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trace_env_var": {
          "type": "string",
          "minLength": 1
        },
        "case_id_env_var": {
          "type": "string",
          "minLength": 1
        },
        "minimum_gap_cases": {
          "type": "integer",
          "minimum": 3
        },
        "required_gap_reasons": {
          "description": "Every reason must be one of Guide §4.3's four concepts, spelled exactly as in the family capability reference.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gap_reason"
          }
        },
        "formal_call_surface": {
          "description": "Normative B-tier packages call the library through this public framework surface; direct backend-library calls are research-only.",
          "enum": [
            "torch_musa"
          ]
        },
        "dispatch_file_note": {
          "type": "string"
        }
      }
    },
    "starter": {
      "description": "Guide §4.6. The inventory that goes with the starter project: which files may be edited and where the marked regions sit, which files are frozen, and how the project is built and run. The evaluator reads `frozen` to decide whether a submission reached outside the scope it was given.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editable",
        "frozen",
        "build",
        "self_test",
        "abi"
      ],
      "properties": {
        "editable": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "submit_as",
              "regions"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 3
              },
              "submit_as": {
                "type": "string",
                "minLength": 3
              },
              "regions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        },
        "frozen": {
          "description": "Package-relative files a submission may not modify. Empty is not accepted: a package with nothing frozen has no boundary for the audit to draw.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "build": {
          "$ref": "#/$defs/command_block"
        },
        "self_test": {
          "$ref": "#/$defs/command_block"
        },
        "abi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputs",
            "outputs",
            "transport",
            "submission",
            "runner_imports_libtorch"
          ],
          "properties": {
            "inputs": {
              "type": "string",
              "minLength": 3
            },
            "outputs": {
              "type": "string",
              "minLength": 3
            },
            "transport": {
              "type": "string",
              "minLength": 3
            },
            "submission": {
              "type": "string",
              "minLength": 3
            },
            "runner": {
              "type": "string",
              "minLength": 3
            },
            "runner_imports_libtorch": {
              "type": "boolean"
            },
            "deviation": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "link_whitelist": {
          "description": "§4.6's B-tier-only entry: the libraries the build may link, mirroring `library_policy`. A submission may not have a wider whitelist than its contract, so the two are required to agree.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "allowed_libraries",
            "allowed_symbol_prefixes",
            "checked_by"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 3
            },
            "allowed_libraries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "allowed_symbol_prefixes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "checked_by": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "dispatch": {
          "description": "Guide §4.1's B-tier-only dispatch-file field, expressed for a submission that is one module: the file it is submitted as, and the region of it the dispatch lives in.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "region",
            "note"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 3
            },
            "region": {
              "type": "string",
              "minLength": 3
            },
            "note": {
              "type": "string",
              "minLength": 30
            }
          }
        },
        "cpp": {
          "description": "Guide §4.6's frozen ABI, realised as a compiled project: a runner that reads the input directory and writes the output directory with no libtorch, a build script that applies the contract's link whitelist, and one editable kernel. The Python module path and this one share the same tensor transport, so a golden is valid for both.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "build",
            "editable",
            "frozen",
            "entrypoint",
            "abi",
            "runner_imports_libtorch",
            "links",
            "command",
            "regions"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 3
            },
            "build": {
              "type": "string",
              "minLength": 3
            },
            "editable": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "frozen": {
