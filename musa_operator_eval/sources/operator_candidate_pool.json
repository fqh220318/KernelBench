  "families": [
    {
      "family_id": "gemm_linear",
      "title": "GEMM、批量/分组矩阵乘与量化线性",
      "selection_reason": "本地 S4000 归档显示多个 GEMM 题的库路径相对朴素 kernel 有 53x 以上差距，同时 MUTLASS、MATE 和 torch_musa 都有独立实现证据。",
      "semantic_contract_focus": ["转置与 batch 广播", "累加 dtype", "量化 scale 粒度", "epilogue 顺序", "ragged group 边界"]
    },
    {
      "family_id": "convolution",
      "title": "卷积、深度可分离卷积与转置卷积",
      "selection_reason": "本地归档中的 Conv2D/ConvTranspose 候选拥有最大的库与朴素实现差距，且存在 shape、group、dilation 和 layout 的自然分派边界。",
      "semantic_contract_focus": ["NCHW/NHWC layout", "padding 约定", "stride/dilation/groups", "output_padding", "bias 与 activation 融合顺序"]
    },
    {
      "family_id": "normalization",
      "title": "RMSNorm、LayerNorm、GroupNorm 与残差融合",
      "selection_reason": "torch_musa 有正式 benchmark 和单元测试，MATE、vLLM-MUSA、ONNX Runtime MUSA 与社区实现又提供了融合版本，适合区分普通库调用和融合调度。",
      "semantic_contract_focus": ["归约轴", "epsilon 位置", "输入与累加 dtype", "affine 参数", "残差写回与 inplace 规则"]
    },
    {
      "family_id": "reduction_scan_selection",
      "title": "归约、Scan 与 TopK 选择",
      "selection_reason": "这些算子有明确的动态轴和非对齐边界，官方源码覆盖 reduce、scan、segment reduce 与 TopK，多项目可交叉核对语义。",
      "semantic_contract_focus": ["轴与 keepdim", "稳定排序和 tie break", "NaN 传播", "exclusive/reverse scan", "空张量与非连续 stride"]
    },
    {
      "family_id": "moe_routing",
      "title": "MoE 路由、Grouped TopK 与混合精度专家 GEMM",
      "selection_reason": "MATE 与 vLLM-MUSA 都包含面向 S5000 的实际路由和 expert kernel，天然包含库路径、分派与自研兜底三层。",
      "semantic_contract_focus": ["token 到 expert 映射", "capacity 与 padding", "TopK tie break", "scale/zero-point", "ragged expert offsets"]
    },
    {
      "family_id": "transformer_fusions",
      "title": "RoPE、量化与状态空间融合算子",
      "selection_reason": "官方仓库已经出现 RoPE、RoPE+量化和 causal Conv1D/scan 等生产路径，但 KernelBench 目前缺少独立题目，适合作为下一批语义契约建设对象。",
      "semantic_contract_focus": ["position id 和 rotary layout", "交错/非交错 RoPE", "量化舍入与 scale", "状态更新顺序", "变长序列边界"]
    }
  ],
